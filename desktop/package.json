{
  "name": "netcube-intent-desktop",
  "version": "0.11.0",
  "description": "NetCube Intent - network intent, routing, VXLAN and switch hardening desktop tool",
  "main": "main.js",
  "author": "eesen77",
  "license": "MIT",
  "private": true,
  "scripts": {
    "sync": "node sync-app.js",
    "build:portable": "node sync-app.js && electron-builder --win portable",
    "build:installer": "node sync-app.js && electron-builder --win nsis",
    "build:win": "node sync-app.js && electron-builder --win nsis portable"
  },
  "build": {
    "appId": "com.netcube.intent",
    "productName": "NetCube Intent",
    "asar": true,
    "files": [
      "main.js",
      "app/**/*"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "portable": {
      "artifactName": "NetCube-Intent-${version}-Portable.exe"
    },
    "compression": "maximum",
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "NetCube Intent",
      "deleteAppDataOnUninstall": false,
      "artifactName": "NetCube-Intent-${version}-Setup.exe"
    }
  },
  "devDependencies": {
    "electron": "^45.3.0",
    "electron-builder": "^26.18.0"
  }
}
