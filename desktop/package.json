{
  "name": "netcube-intent-desktop",
  "version": "0.7.0",
  "description": "NetCube Intent - network intent, routing, VXLAN and switch hardening desktop tool",
  "main": "main.js",
  "author": "NetCube",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "sync": "node sync-app.js",
    "build:win": "node sync-app.js && electron-builder --win portable"
  },
  "build": {
    "appId": "com.netcube.intent",
    "productName": "NetCube Intent",
    "asar": true,
    "files": [
      "main.js",
      "app/**/*"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        "portable"
      ],
      "artifactName": "NetCube-Intent-${version}-Portable.exe"
    },
    "portable": {
      "artifactName": "NetCube-Intent-${version}-Portable.exe"
    },
    "compression": "maximum"
  },
  "devDependencies": {
    "electron": "^45.3.0",
    "electron-builder": "^26.18.0"
  }
}
